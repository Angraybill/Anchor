# Public values used by the Expo client.
# Copy this file to .env.local and fill in your Supabase project values.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase Edge Function values. Set these with `supabase secrets set`.
# Never expose these in the Expo app or commit them to Git.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=
# POSTMARK_API_KEY= # or SENDGRID_API_KEY; configure one for deployed email delivery
# FROM_EMAIL=verified-sender@your-domain.example
# DEV_RETURN_CODE=true # local development only; never enable this in production
# PICKUP_REVEAL_ENCRYPTION_KEY=base64url-encoded-32-byte-key
