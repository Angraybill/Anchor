# Generated for the PolyPassengers Expo local development setup.
# This file documents required configuration without containing real credentials.
# DO NOT place production or server-only secrets in this file.
# Store real values securely (for example, in a password manager or secrets vault).

# Browser-safe Supabase configuration only. Use a publishable/anon key, never a secret key.
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Set server-only values only with `supabase secrets set`.
# Never add them to browser code, .env.local, logs, or Git.
# SUPABASE_SERVICE_ROLE_KEY=""
# POSTMARK_API_KEY="" # Or SENDGRID_API_KEY; configure one for deployed email delivery.
# FROM_EMAIL="verified-sender@your-domain.example"
# DEV_RETURN_CODE="true" # Local development only; never enable in production.
# PICKUP_REVEAL_ENCRYPTION_KEY=""
